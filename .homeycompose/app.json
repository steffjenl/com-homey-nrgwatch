    "actions": [
      {
        "id": "set_fan_mode",
        "title": {
          "en": "Set fan mode",
          "nl": "Stel ventilatiemodus in",
          "de": "Lüftungsmodus einstellen",
          "fr": "Définir le mode de ventilation",
