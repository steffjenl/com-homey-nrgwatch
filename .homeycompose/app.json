  "flow": {
    "triggers": [
      {
        "id": "fan_mode_changed",
        "title": {
          "en": "The fan mode has changed",
          "nl": "De ventilatiemodus is gewijzigd",
          "de": "Der Lüftungsmodus hat sich geändert",
          "fr": "Le mode de ventilation a changé",
          "it": "La modalità ventilazione è cambiata",
          "sv": "Fläktläget har ändrats",
          "no": "Vifteinnstillingen er endret",
          "es": "El modo de ventilación ha cambiado",
          "da": "Ventilatortilstanden er ændret",
          "ru": "Режим вентилятора изменён",
          "pl": "Tryb wentylatora zmieniony",
          "ko": "팬 모드가 변경되었습니다"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode", "nl": "Modus", "de": "Modus", "fr": "Mode",
              "it": "Modalità", "sv": "Läge", "no": "Innstilling",
              "es": "Modo", "da": "Tilstand", "ru": "Режим", "pl": "Tryb", "ko": "모드"
            },
            "example": "low"
          }
        ]
      },
      {
        "id": "co2_threshold_exceeded",
        "title": {
          "en": "CO2 level exceeds threshold",
          "nl": "CO2-niveau overschrijdt drempelwaarde",
          "de": "CO2-Wert überschreitet Schwellenwert",
          "fr": "Le niveau CO2 dépasse le seuil",
          "it": "Il livello CO2 supera la soglia",
          "sv": "CO2-nivån överstiger tröskelvärdet",
          "no": "CO2-nivå overskrider terskelverdien",
          "es": "El nivel de CO2 supera el umbral",
          "da": "CO2-niveau overskrider tærsklen",
          "ru": "Уровень CO2 превысил порог",
          "pl": "Poziom CO2 przekracza próg",
          "ko": "CO2 수준이 임계값을 초과했습니다"
        },
        "args": [
          {
            "name": "threshold",
            "type": "number",
            "title": {
              "en": "CO2 threshold (ppm)", "nl": "CO2-drempelwaarde (ppm)",
              "de": "CO2-Schwellenwert (ppm)", "fr": "Seuil CO2 (ppm)",
              "it": "Soglia CO2 (ppm)", "sv": "CO2-tröskel (ppm)",
              "no": "CO2-terskel (ppm)", "es": "Umbral CO2 (ppm)",
