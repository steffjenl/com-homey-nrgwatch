        "tokens": [
          {
            "name": "co2_ppm",
            "type": "number",
            "title": {
              "en": "CO2 (ppm)", "nl": "CO2 (ppm)", "de": "CO2 (ppm)",
              "fr": "CO2 (ppm)", "it": "CO2 (ppm)", "sv": "CO2 (ppm)",
              "no": "CO2 (ppm)", "es": "CO2 (ppm)", "da": "CO2 (ppm)",
              "ru": "CO2 (ppm)", "pl": "CO2 (ppm)", "ko": "CO2 (ppm)"
            },
            "example": 850
          }
        ]
      },
      {
